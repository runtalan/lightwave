# Govee Developer Cloud API key (https://developer.govee.com)
# Used only for initial device discovery. Never commit a real key.
GOVEE_API_KEY=your_govee_developer_api_key_here

# MIDI Control Change number for the brightness slider (Glorious/VIA often uses 7).
MIDI_CC=7
# Alternate CC also treated as brightness (mod wheel is commonly 1).
MIDI_CC_ALT=1

# MIDI Note On numbers for Color Engine +/- when the numpad sends notes instead of keys.
MIDI_NOTE_PLUS=60
MIDI_NOTE_MINUS=61
